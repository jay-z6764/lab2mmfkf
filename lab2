#include <stdio.h>

int a(int n) {
    if (n == 1) return 1;
    if (n == 2) return 2;
    return a(n - 1) + a(n - 2);
}

int main() {
    int n;
    printf("Введи N: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Ошибка: N должно быть больше нуля!\n");
    } else {
        printf("Ответ: %d\n", a(n));
    }

    return 0;
}
