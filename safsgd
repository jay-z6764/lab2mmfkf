#include <stdio.h>
#include <stdlib.h>

int is_natural_string(const char *str) {
    if (str[0] == '\0' || str[0] == '0' || str[0] == '-')
        return 0;

    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] < '0' || str[i] > '9') {
            return 0;
        }
    }

    return 1;
}

int is_integer_string(const char *str) {
    int start = 0;

    if (str[0] == '-' || str[0] == '+') {
        start += 1;
    }

    if (str[start] == '\0') {
        return 0;
    }

    for (int i = start; str[i] != '\0'; i++) {
        if (str[i] < '0' || str[i] > '9') {
            return 0;
        }
    }

    return 1;
}

int is_float_string(const char *str) {
    int start = 0;

    if (str[0] == '-' || str[0] == '+') {
        start += 1;
    }

    if (str[start] == '\0') {
        return 0;
    }

    int dot_count = 0;
    int digit_count = 0;

    for (int i = start; str[i] != '\0'; i++) {
        if (str[i] == '.') {
            dot_count++;

            if (dot_count > 1) {
                return 0;
            }
        }
        else if (str[i] >= '0' && str[i] <= '9') {
            digit_count++;
        }
        else {
            return 0;
        }
    }

    if (digit_count == 0) {
        return 0;
    }

    return 1;
}

int main() {

    char *N_str = NULL;
    char *M_str = NULL;

    int M, N;

    while (1) {
        printf("Vvedite N: ");

        if (scanf("%ms", &N_str) != 1) {
            printf("Oshibka vvoda!\n");
            free(N_str);
            return 1;
        }

        if (is_natural_string(N_str)) {
            N = atoi(N_str);
            free(N_str);
            N_str = NULL;

            if (N >= 3)
                break;
        }
        else {
            free(N_str);
            N_str = NULL;
        }

        printf("Nuzhno vvesti celoe chislo ne menshe 3!\n");
    }

    while (1) {
        printf("Vvedite M: ");

        if (scanf("%ms", &M_str) != 1) {
            printf("Oshibka vvoda!\n");
            free(M_str);
            return 1;
        }

        if (is_natural_string(M_str)) {
            M = atoi(M_str);
            free(M_str);
            M_str = NULL;

            if (M >= 3)
                break;
        }
        else {
            free(M_str);
            M_str = NULL;
        }

        printf("Nuzhno vvesti celoe chislo ne menshe 3!\n");
    }

    float *Matrix = malloc((size_t)N * M * sizeof(float));

    if (Matrix == NULL) {
        printf("Oshibka vydeleniya pamyati!\n");
        return 1;
    }

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {

            char *element = NULL;
            float value;

            while (1) {
                printf("Vvedite element [%d][%d]: ", i, j);

                if (scanf("%ms", &element) != 1) {
                    printf("Oshibka vvoda!\n");
                    free(element);
                    free(Matrix);
                    return 1;
                }

                if (is_float_string(element)) {
                    value = atof(element);
                    free(element);
                    break;
                }
                else {
                    free(element);
                    element = NULL;
                    printf("Nevernyy vvod! Poprobuyte snova.\n");
                }
            }

            Matrix[i * M + j] = value;
        }
    }

    // 1. Zamenit otricatelnye elementy glavnoy diagonali

    for (int i = 0; i < N && i < M; i++) {
        if (Matrix[i * M + i] < 0) {
            Matrix[i * M + i] = -Matrix[i * M + i];
        }
    }

    // 2. Nayti maksimalnyy element vtoroy stroki

    int k = -1;
    float max = 0;

    for (int j = 0; j < M; j++) {
        if (Matrix[M + j] >= -1.2 && Matrix[M + j] <= 4.7) {
            if (k == -1 || Matrix[M + j] > max) {
                max = Matrix[M + j];
                k = j;
            }
        }
    }

    // 3. Pomenyat naydennyy element mestami s a33

    if (k != -1) {
        float temp = Matrix[M + k];
        Matrix[M + k] = Matrix[2 * M + 2];
        Matrix[2 * M + 2] = temp;
   else {
        printf("Vo vtoroy stroke net podhodyashchih elementov!\n");
    }

    printf("Rezultat:\n");

    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            printf("| %f |", Matrix[i * M + j]);
        }

        printf("\n");
    }

    free(Matrix);

    return 0;
}}
